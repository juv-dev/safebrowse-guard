{
  "manifest_version": 3,
  "name": "Anime Guard Strict",
  "version": "1.0.0",
  "description": "Bloquea anime/manga con se\u00f1ales de contenido sexual o adulto usando la p\u00e1gina + AniList.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://graphql.anilist.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Anime Guard Strict"
  },
  "options_page": "options.html"
}